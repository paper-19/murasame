# Copy to .env (ignored by git); bin/murasame loads it. Sourced as bash: quote values with spaces or $.
MURASAME_CONFIG=examples/generic.toml
# examples/generic.toml reads these:
# MURASAME_FORGEJO_URL=
# MURASAME_FORGEJO_OWNER=
# MURASAME_FORGEJO_REPO=
# MURASAME_GIT_URL=
# The bot's token and the webhook secret (uncomment: an empty value would override your shell's):
# MURASAME_FORGEJO_TOKEN=
# MURASAME_WEBHOOK_SECRET=
